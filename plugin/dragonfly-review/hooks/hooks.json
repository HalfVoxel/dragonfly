{
  "description": "Injects dragonfly-collected PR context into the reviewer subagents",
  "hooks": {
    "SubagentStart": [
      {
        "matcher": "review-agent|comment-reviewer|dedup-reviewer|test-reviewer",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/review-context.py",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
